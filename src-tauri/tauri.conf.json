{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StreamDash",
  "version": "1.11.0",
  "identifier": "dev.streamdash.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "appDirectoriesOverride": "$DATA/StreamDash",
    "windows": [
      {
        "title": "StreamDash",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#0b0c0f",
        "visible": false,
        "useHttpsScheme": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://id.twitch.tv https://api.twitch.tv https://7tv.io https://api.7tv.app https://api.tipeeestream.com https://*.tipeeestream.com https://raw.githubusercontent.com wss://eventsub.wss.twitch.tv wss://astro.streamelements.com wss://*.tipeeestream.com ws://127.0.0.1:* ws://localhost:*; frame-src https: http://localhost:* http://127.0.0.1:*; img-src 'self' asset: http://127.0.0.1:* http://localhost:* https://static-cdn.jtvnw.net https://cdn.7tv.app data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Tenkayro",
    "copyright": "Copyright © 2026 Tenkayro",
    "createUpdaterArtifacts": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": [
          "en-US"
        ],
        "fragmentPaths": [
          "wix/user-data.wxs"
        ],
        "componentRefs": [
          "UserDataPreference"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGRjI5Rjg3MDc2N0IyRjQKUldUMHNtY0hoNS95ajZaandnQjdMbksrOW0xUjB4RXhGMDZUc3dpTU1Gc3VlZEtOVCtiNGpRTzIK",
      "endpoints": [
        "https://github.com/Tenkayro/StreamDash/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
